{
  "_comment": "LTX-2.5 image-to-video ComfyUI API-format workflow. Derived node-for-node from the OFFICIAL template at github.com/Comfy-Org/workflow_templates/blob/main/templates/video_ltx2_5_i2v.json (fetched from raw.githubusercontent.com). {{IMAGE_FILENAME}} into node 395 (LoadImage, 'Load First Frame'). {{PROMPT}} into node 376. {{SEED}} into node 339's noise_seed (low-res pass; high-res pass, node 338, always uses the template's fixed seed 42). {{WIDTH}} into node 372, {{HEIGHT}} into node 360, {{FPS}} into node 361. {{FRAMES}} into node 362 - NOTE: this is DURATION IN SECONDS, not a raw frame count (computed internally as duration*frame_rate+1 via node 378's ComfyMathExpression) - ComfyUIProvider._generate must pass duration seconds here for local_model='ltx25'. {{FILENAME_PREFIX}} into node 75 (SaveVideo). The image-conditioning chain (351 ResizeImageMaskNode, 350 LTXVPreprocess, 357/349 LTXVImgToVideoInplace, 363 'Switch to Text to Video?' boolean) and the audio branch (358/366/340/377/367/369) are kept with their real official-template values, even though VOXini does not use the AUDIO output yet. Requires the same GATED https://huggingface.co/Lightricks/LTX-2.5 model files as ltx25_text_to_video.json. FIX (same root cause as ltx25_text_to_video.json, applied here without a fresh live test of THIS specific i2v template - the t2v template's identical fix WAS live-verified 2026-09-27, VOXini test run; this file mirrors that exact fix pattern but is otherwise unverified as of this edit): unlike the t2v official template, this i2v official template ships with prompt_enhance (node 383) defaulting to TRUE, so it would have exercised the broken TextGenerateLTX2Prompt node (380, missing required 'max_length' + ~10 other undocumented widgets) on every single call, not just when explicitly enabled. The entire prompt-enhancer branch (nodes 380, 382, 383, 393, 381) has been REMOVED - node 364 (CLIPTextEncode, positive) now reads directly from node 376 (the raw {{PROMPT}} text) instead of via the removed switch. Prompt-enhancement is therefore permanently off in this template, same as the t2v one. LTXVDualCFGGuider (nodes 391, 388) video_cfg/audio_cfg cross-checked against docs.comfy.org/built-in-nodes/LTXVDualCFGGuider. LTXVImgToVideoInplace (nodes 357, 349) unnamed leading widget emitted as 'strength' by best-effort naming. LTXVPreprocess (node 350) unnamed widget emitted as 'img_compression'. ResizeImageMaskNode (node 351) unnamed widgets emitted as 'mode'/'value'/'interpolation'. ComfyMathExpression's formula-string widget emitted as 'expression'. CreateVideo (node 370) second widgets_values entry (8) has no corresponding named input and was left out.",
  "395": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{IMAGE_FILENAME}}",
      "upload": "image"
    }
  },
  "75": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["370", 0],
      "filename_prefix": "{{FILENAME_PREFIX}}",
      "format": "auto",
      "codec": "auto"
    }
  },
  "364": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["387", 0],
      "text": ["376", 0]
    }
  },
  "376": {
    "class_type": "PrimitiveStringMultiline",
    "inputs": {
      "value": "{{PROMPT}}"
    }
  },
  "384": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "362": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": "{{FRAMES}}"
    }
  },
  "363": {
    "class_type": "PrimitiveBoolean",
    "inputs": {
      "value": false
    }
  },
  "365": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": ["364", 0],
      "negative": ["373", 0],
      "frame_rate": ["359", 0]
    }
  },
  "385": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    }
  },
  "386": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    }
  },
  "372": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": "{{WIDTH}}"
    }
  },
  "373": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["387", 0],
      "text": "{{NEGATIVE_PROMPT}}"
    }
  },
  "387": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "360": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": "{{HEIGHT}}"
    }
  },
  "352": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "339": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": "{{SEED}}"
    }
  },
  "397": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    }
  },
  "361": {
    "class_type": "PrimitiveInt",
    "inputs": {
      "value": "{{FPS}}"
    }
  },
  "371": {
    "class_type": "LatentUpscaleModelLoader",
    "inputs": {
      "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"
    }
  },
  "357": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": ["385", 0],
      "image": ["350", 0],
      "latent": ["356", 0],
      "bypass": ["363", 0],
      "strength": 0.7
    }
  },
  "366": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "audio_vae": ["386", 0],
      "frames_number": ["378", 1],
      "frame_rate": ["359", 1],
      "batch_size": 1
    }
  },
  "367": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": ["344", 0]
    }
  },
  "377": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": ["357", 0],
      "audio_latent": ["366", 0]
    }
  },
  "351": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": ["395", 0],
      "mode": "scale longer dimension",
      "value": 1536,
      "interpolation": "lanczos"
    }
  },
  "353": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a/2",
      "values.a": ["372", 0]
    }
  },
  "355": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a/2",
      "values.a": ["360", 0]
    }
  },
  "350": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": ["351", 0],
      "img_compression": 18
    }
  },
  "356": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": ["353", 1],
      "height": ["355", 1],
      "length": ["378", 1],
      "batch_size": 1
    }
  },
  "348": {
    "class_type": "LTXVLatentUpsampler",
    "inputs": {
      "samples": ["367", 0],
      "upscale_model": ["371", 0],
      "vae": ["385", 0]
    }
  },
  "349": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": ["385", 0],
      "image": ["350", 0],
      "latent": ["348", 0],
      "bypass": ["363", 0],
      "strength": 1
    }
  },
  "359": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a",
      "values.a": ["361", 0]
    }
  },
  "378": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a * b + 1",
      "values.a": ["362", 0],
      "values.b": ["361", 0]
    }
  },
  "338": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 42
    }
  },
  "340": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": ["349", 0],
      "audio_latent": ["367", 1]
    }
  },
  "396": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "0.85, 0.7250, 0.4219, 0.0"
    }
  },
  "391": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": ["384", 0],
      "positive": ["365", 0],
      "negative": ["365", 1],
      "video_cfg": 1,
      "audio_cfg": 1
    }
  },
  "341": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "368": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["338", 0],
      "guider": ["391", 0],
      "sampler": ["341", 0],
      "sigmas": ["396", 0],
      "latent_image": ["340", 0]
    }
  },
  "369": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": ["368", 0]
    }
  },
  "374": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": ["369", 0],
      "vae": ["385", 0],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 16
    }
  },
  "358": {
    "class_type": "LTXVAudioVAEDecode",
    "inputs": {
      "samples": ["369", 1],
      "audio_vae": ["386", 0]
    }
  },
  "370": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["374", 0],
      "audio": ["358", 0],
      "fps": ["359", 0]
    }
  },
  "344": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["339", 0],
      "guider": ["388", 0],
      "sampler": ["352", 0],
      "sigmas": ["397", 0],
      "latent_image": ["377", 0]
    }
  },
  "388": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": {
      "model": ["384", 0],
      "positive": ["365", 0],
      "negative": ["365", 1],
      "video_cfg": 1,
      "audio_cfg": 1
    }
  }
}
